# GEMINI_API_KEY: Required for Gemini AI API calls if any.
GEMINI_API_KEY=

# API base URL for the Synology external API
VITE_API_BASE_URL="https://sns.teranago.synology.me"

# Frontend Public URL (Used for invitation / password reset / safety confirmation links)
APP_BASE_URL="https://teranago-sns.github.io/po/"

# Additional Allowed CORS Origins (comma-separated, exact match origins without path)
# Example: ALLOWED_ORIGINS="https://teranago-sns.github.io,https://sns.teranago.synology.me"
ALLOWED_ORIGINS="https://teranago-sns.github.io"

# MS SQL Server Connection Settings (Set actual values in .env only)
DB_SERVER=
DB_USER=
DB_PASSWORD=
DB_DATABASE=teranago_sns
DB_ENCRYPT=false

# Personal Email Encryption Key (AES-256-GCM) - REQUIRED (32+ random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PERSONAL_EMAIL_SECRET_KEY=

# Optional: Previous Personal Email Encryption Key (for automatic re-encryption migration on startup)
OLD_PERSONAL_EMAIL_SECRET_KEY=

# Initial Admin Account (Used ONLY when 0 users exist in DB / users.json; forces password change on first login)
INITIAL_ADMIN_LOGIN_ID=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME="初期管理者"

# Web Push (VAPID) keys for persistent push notification support across restarts
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL="mailto:admin@example.com"

# SMTP Email Notification Settings (Set actual values in .env only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME="社内ポータル通知（返信不可）"

# POP3 Inbound Mail Settings (Set actual values in .env only; falls back to SMTP_* if omitted)
POP3_HOST=
POP3_PORT=110
POP3_SECURE=false
POP3_USER=
POP3_PASS=
POP3_DELETE_AFTER_IMPORT=true
POP3_CHECK_INTERVAL_SEC=60
POP3_DEFAULT_TAG="社内メール"


